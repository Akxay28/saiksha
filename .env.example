# Public app URL, for sitemap and absolute links
APP_URL=https://your-domain.com

# Server port. Most hosts set this automatically.
PORT=3000

# MongoDB Atlas connection string. Required for products, orders, admin data,
# live visitors, cart leads, wishlist leads, search analytics, and settings.
MONGODB_URI=

# Admin login. Change these in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Email notifications through Resend. Optional, but recommended.
RESEND_API_KEY=
ADMIN_EMAIL=
# For customer emails, this must use a domain verified in Resend.
# Example: Saiksha Orders <orders@your-domain.com>
ORDER_EMAIL_FROM=

# Customer order confirmation emails through Nodemailer SMTP.
# If these are set, SMTP is used before Resend for customer confirmations.
# Gmail STARTTLS example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_SECURE=false, SMTP_REQUIRE_TLS=true, SMTP_PASS=your Gmail app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_EMAIL_FROM=

# Razorpay online payments. Optional if you only use COD.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
